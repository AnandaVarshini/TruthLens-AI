# Copy this file to .env (project root) and change the values for your machine.
# NEVER commit a real .env file to Git or include it in a submission ZIP.

# Secret used to sign JWT access tokens. Use a long random string (32+ characters).
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
TRUTHLENS_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Login token lifetime in minutes (720 = 12 hours)
TRUTHLENS_TOKEN_MINUTES=720

# Allowed frontend origins (comma separated) for local development
TRUTHLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional: override the SQLite database location.
# Relative paths are resolved from the project root.
# TRUTHLENS_DB_PATH=backend/truthlens.db
